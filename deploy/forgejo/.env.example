# Forgejo registry secrets — TEMPLATE ONLY. The real ./.env is created on the
# host at deploy time from OpenBao and is NEVER committed (see .gitignore + the
# RUNBOOK). Values here are placeholders; only VARIABLE NAMES and their OpenBao
# source paths are recorded.

# Dedicated Postgres password for Forgejo metadata.
#   OpenBao: secret/dotmac/forgejo/db-password
FORGEJO_DB_PASSWORD=

# Scoped MinIO service account (read/write on the artifact bucket ONLY — not the
# MinIO root account). Created via `mc admin user svcacct add` (RUNBOOK step 1).
#   OpenBao: secret/dotmac/forgejo/minio-svc  (fields: access_key, secret_key)
FORGEJO_MINIO_ACCESS_KEY=
FORGEJO_MINIO_SECRET_KEY=

# The artifact bucket name (non-secret; default dotmac-packages).
FORGEJO_MINIO_BUCKET=dotmac-packages
