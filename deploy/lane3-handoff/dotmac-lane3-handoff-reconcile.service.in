# Review aid only. Installer.unit_bytes renders the actual digest-pinned unit.
[Unit]
Description=Reconcile Lane 3 handoff before management admission
Requires=@BASELINE_UNIT@
After=local-fs.target @BASELINE_UNIT@
Before=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -I -B /opt/dotmac-lane3-handoff/@BUNDLE_DIGEST@/lane3_handoff_install.py boot-reconcile
TimeoutStartSec=45

[Install]
WantedBy=multi-user.target
