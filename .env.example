# dotmac_starter_mt — environment configuration.
# Copy to `.env` and fill in change-me placeholders. Every value here has a
# built-in default (see app/core/config.py, scripts/deploy.sh, and the
# compose files) — this file documents them, it does not invent new ones.
# User rule: everything by config, no hardcoding.

# ============================================================================
# App (app/core/config.py — read by the FastAPI process)
# ============================================================================

# Environment: dev | staging | prod. Controls fail-closed validation in
# app/main.py's lifespan (see validate_settings): in prod, PLATFORM_DATABASE_URL,
# TRUSTED_HOSTS, a real PLATFORM_ROOT_DOMAIN, JWT_SECRET, and SESSION_HASH_SECRET
# all become required / must not be left at their dev defaults.
ENVIRONMENT=dev

# Tenant request role (app_user) — RLS-enforced, cannot bypass. Required.
DATABASE_URL=postgresql+psycopg://app_user:change-me@localhost:5432/starter

# Online platform routes role (platform_api) — explicit grants, no RLS bypass.
# Falls back to DATABASE_URL if unset (fine for local dev only). Required in prod.
PLATFORM_DATABASE_URL=

# Migrations/offline maintenance role (app_admin, BYPASSRLS). Used by
# `alembic upgrade` and scripts/deploy.sh only — never by request-handling code.
MIGRATION_DATABASE_URL=

# Where this assembly's migration prerequisite bindings live, as
# `module.path:ATTRIBUTE`. `alembic/env.py` installs them directly, so this is
# not needed for `alembic upgrade`; it is what lets the GRAPH commands
# (`alembic heads`, `history`, `show`) resolve cross-lineage edges, since those
# never run env.py. Unset, they still work — the edges just read as empty.
DOTMAC_MIGRATION_BINDINGS=app.migration_bindings:ASSEMBLY_PREREQUISITE_BINDINGS

# Root domain for subdomain -> tenant resolution, e.g. app.example.com in
# prod. "localhost" in dev — browsers resolve *.localhost without /etc/hosts
# changes (e.g. acme.localhost:8000). This is ALSO the only host the
# platform control plane (/platform/*) exists on: platform routing is
# host-EXACT (app/core/middleware/tenant.py + app/core/platform_auth.py) —
# a /platform/* request on a tenant or unknown host 404s.
PLATFORM_ROOT_DOMAIN=localhost

# Comma-separated allowed Host headers for TrustedHostMiddleware. Only
# enabled when non-empty. Required in prod; leave empty in dev.
TRUSTED_HOSTS=

# Secrets — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Dev defaults below are intentionally insecure sentinels; validate_settings()
# rejects them in prod.
JWT_SECRET=dev-insecure-change-me
SESSION_HASH_SECRET=dev-insecure-change-me
JWT_TTL_SECONDS=3600

# Browser/API guardrails
CSRF_ENABLED=true
CSRF_SECRET=dev-insecure-change-me
CSRF_TOKEN_TTL_SECONDS=7200
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# LRU cap on the in-memory rate-limit store — bounds worst-case memory.
RATE_LIMIT_MAX_KEYS=10000
# RESERVED seam for a Redis-backed RateLimitStore (multi-process deploys).
# No redis dependency ships; see app/core/middleware/rate_limit.py + docs/SECURITY.md.
RATE_LIMIT_REDIS_URL=

# Security response headers + CSP (app/core/middleware/security_headers.py).
# Disable only when a fronting proxy owns these headers. Empty CSP = the
# computed strict default documented in docs/SECURITY.md.
SECURITY_HEADERS_ENABLED=true
CONTENT_SECURITY_POLICY=

# Trust the inbound X-Request-ID header instead of generating one. Only set
# true behind a trusted proxy that normalizes/strips this header — otherwise
# it allows log-poisoning via client-supplied request IDs.
TRUST_INBOUND_REQUEST_ID=false

# Comma-separated feature names to disable (see app/features/__init__.py's
# FEATURE_MODULES for the registered names: tenants, auth, parties, rbac,
# settings, custom_fields, web). A feature listed here is never mounted —
# its routes simply don't exist (404), regardless of its manifest's `core`
# flag. Note: `web` is the admin DASHBOARD shell only (GET /admin) — login
# (owned by `auth`, core) and every other feature's own /admin/* screens
# are unaffected by disabling `web`; disabling e.g. `parties` drops BOTH its
# JSON API and its /admin/parties/* screens together (one feature, one
# switch — see README.md's "Disabling a feature" section). This is NOT the
# API-only switch — see WEB_ENABLED below for that.
DISABLED_FEATURES=

# ── Attribution: which application this is, and which it talks to ───────────
# Every command and every audit row records the APPLICATION that issued it
# (dotmac_kernel.source_applications). Two separate facts, do not conflate:
#
# SOURCE_APPLICATION — which application THIS deployment is. Empty means
# "derive it from the assembly spec's own name" (`dotmac_starter_mt` for the
# reference assembly), which is right whenever that name is already a
# well-formed code: lowercase letters, digits and underscores, starting with a
# letter, 2-64 characters. There is deliberately NO literal fallback such as
# "app" or "system" — an identity every deployment shares is an anonymous
# principal with a name on it, and the column exists to stop those. When
# nothing usable can be derived, no host identity is installed and anything
# this process originates fails loudly at the audit write rather than
# recording a guess. Set it explicitly when the assembly name is not a code.
SOURCE_APPLICATION=
# Comma-separated PEER applications this deployment accepts machine
# credentials and commands from. The host's own code is always accepted and
# needs no entry. Empty is a real answer — "no peer application may call this
# deployment" — and there is deliberately no wildcard entry. Membership is
# exact: `dotmac_sub_staging` does NOT pass as `dotmac_sub`.
ACCEPTED_SOURCE_APPLICATIONS=

# Surface switch (finding F1): false mounts NO feature's admin-portal
# (HTML/HTMX) routes at all — zero /admin routes across every feature, no
# /static mount — for a pure JSON API deployment. Every feature's JSON API
# (app/features/*/router.py) keeps working unchanged either way. Independent
# of DISABLED_FEATURES above, which turns off one NAMED feature (JSON + web
# together); WEB_ENABLED is the whole-surface knob. See
# app/core/features.py's module docstring for the full capability model.
WEB_ENABLED=true

# Seed platform-default setting rows (app/features/settings/seed.py) from the
# lifespan handler on every boot. Idempotent — never overwrites an operator's
# prior change. Set false on a read replica or when a separate deploy step
# seeds instead.
SEED_ON_STARTUP=true

# ============================================================================
# Branding (app/core/branding.py — read directly via os.getenv, NOT part of
# the Settings/app.core.config class). Deployment-STATIC identity: defaults <
# brand.json (repo root) < these env vars. Cached for the process lifetime
# (lru_cache) — a restart is required to pick up a change. All optional; an
# unset value falls through to brand.json, then the built-in generic
# default. Per-TENANT overrides on top of this layer are a DB-backed setting
# (settings/branding/ui_branding), edited at /admin/settings/branding — not
# an env var.
# ============================================================================

# Path to brand.json if not the repo-root default. Rarely needed.
BRAND_CONFIG_PATH=

# Static brand identity overrides — leave unset to use brand.json/defaults.
BRAND_NAME=
BRAND_TAGLINE=
BRAND_PRIMARY_COLOR=
BRAND_ACCENT_COLOR=
BRAND_SUPPORT_EMAIL=
BRAND_APP_URL=

# ============================================================================
# Deploy / Docker (docker-compose.yml, docker-compose.dev.yml, scripts/deploy.sh)
# ============================================================================

# Published image ref, e.g. registry/dotmac_starter_mt:0.4.0. Required by
# docker-compose.yml (prod); pinned automatically by `make deploy TAG=...`
# (scripts/deploy.sh) — you normally don't set this by hand.
APP_IMAGE=

# Host bind port AND the port the app listens on inside the container.
# Must match the image's APP_PORT build-arg if you rebuild with a different
# port baked in. Default 8000.
APP_PORT=8000

# Container resource limits (docker-compose.yml prod service).
APP_MEM_LIMIT=512m
APP_PIDS_LIMIT=256

# Host scripts/deploy.sh curls for the post-deploy health gate. Default
# 127.0.0.1.
DEPLOY_HEALTH_HOST=127.0.0.1

# Health-gate retry policy for scripts/deploy.sh.
HEALTH_RETRIES=15
HEALTH_INTERVAL=2
HEALTH_CURL_TIMEOUT=5

# Directory scripts/deploy.sh writes pre-migration pg_dump backups to
# (relative to the repo root unless absolute). Default "backups".
BACKUP_DIR=backups

# Compose file scripts/deploy.sh operates on. Default docker-compose.yml —
# override only if you maintain an alternate prod compose layout.
COMPOSE_FILE_PROD=docker-compose.yml

# ── WS8 licence receiver (app/features/licensing) ──────────────────────────
# Deployment-level trust config for signed-licence verification. The keyring
# is PUBLIC verification material (the vendor's licence signing keys) as a
# JSON list: [{"key_id": "...", "public_key_b64": "...", "status": "active"}]
# (status: active|retired|revoked). Default [] — every licence then fails
# closed with UnknownKeyError until keys are configured.
LICENCE_VERIFICATION_KEYS=[]
# This deployment's identity for deployment-bound licences. Unset = a bound
# licence is rejected (fail closed); portable licences still verify.
LICENCE_DEPLOYMENT_ID=
# Refuse portable (unbound) licences. Default false.
LICENCE_REQUIRE_BINDING=false

# ── Settings-secret encryption (dotmac_kernel.settings_crypto) ─────────────
# Encrypts the value of any setting whose spec sets is_secret. Unset is safe for
# this reference assembly, which declares NO secret setting: nothing encrypts,
# nothing reads. The moment a deployment declares one, writing it without a key
# RAISES rather than storing plaintext. Needs the `settings-crypto` extra.
#
# Generate a key with:
#   python -c "from cryptography.fernet import Fernet; \
#     print(Fernet.generate_key().decode())"
#
# Single key — the common case. Stored values carry the id "default".
# SETTINGS_ENCRYPTION_KEY=
# Or a file holding that key: the shape a container secret, a Kubernetes
# mounted secret, or an OpenBao Agent template produces. The kernel never
# fetches a secret over the network — settings resolution is a per-request read
# path, and a secret store's outage must not become a total outage. Which store
# a deployment uses is its own decision; env-or-file is the contract.
# SETTINGS_ENCRYPTION_KEY_FILE=
#
# Keyring — required to ROTATE, because the key id is written into every value.
# JSON list; exactly one entry may be "active" (it encrypts new values), any
# number may be "retired" (still decrypt, for rows not yet rewritten), and
# "revoked" decrypts nothing. Rotation: add a new active key, retire the old
# one, run dotmac_kernel.settings_crypto.reencrypt_secrets, then drop it.
# SETTINGS_ENCRYPTION_KEYS=[{"key_id":"2026-08","key":"...","status":"active"},{"key_id":"2026-02","key":"...","status":"retired"}]
