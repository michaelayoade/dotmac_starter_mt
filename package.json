{
  "name": "dotmac_starter_mt",
  "version": "0.1.0",
  "description": "Tailwind CSS build for the dotmac_starter_mt admin web UI",
  "private": true,
  "scripts": {
    "css:build": "npx tailwindcss -i ./packages/dotmac-kernel/src/dotmac_kernel/static/css/src/main.css -o ./packages/dotmac-kernel/src/dotmac_kernel/static/css/main.css --minify",
    "css:watch": "npx tailwindcss -i ./packages/dotmac-kernel/src/dotmac_kernel/static/css/src/main.css -o ./packages/dotmac-kernel/src/dotmac_kernel/static/css/main.css --watch",
    "build": "npm run css:build",
    "dev": "npm run css:watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18"
  }
}
