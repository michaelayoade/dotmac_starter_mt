# /etc/systemd/system/dotmac-secrets-purge@@SECRETS_NAMESPACE@-@ROLE@.service.d/secrets-purge.conf
# Per ROLE instance (the secrets directory is per role, shared by every material set).
# The owning uid (import: dotmac-erp-import, not in the docker group) and the one
# directory this instance may write and empty.
[Service]
User=@OWNER_USER@
ReadWritePaths=/run/dotmac/@SECRETS_NAMESPACE@/@ROLE@/secrets
ExecStart=
# find -P never follows a symlink and -xdev never leaves the filesystem: a link in
# secrets/ is removed AS A LINK, its target untouched. Directories are left alone.
ExecStart=/usr/bin/find -P /run/dotmac/@SECRETS_NAMESPACE@/@ROLE@/secrets -xdev -mindepth 1 -maxdepth 1 ! -type d -delete
