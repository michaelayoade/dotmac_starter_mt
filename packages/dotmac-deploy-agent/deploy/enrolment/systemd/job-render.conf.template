# /etc/systemd/system/openbao-agent@@SECRETS_NAMESPACE@-@ROLE@.service.d/job-render.conf
# JOB ROLES ONLY: render once and exit. The authored HCL sets exit_after_auth and
# no meta/render file. The agent reads Result=success and ExecMainStatus=0 from
# `systemctl show` as the render-and-login signal.
[Service]
Type=oneshot
Restart=no
RemainAfterExit=no
# The file set is checked INSIDE the unit, as the container uid (User= comes from
# instance.conf): a mismatch, a wrong mode or an undeclared file fails the unit.
# @DECLARED_FILES@ is the space-separated lower-case file names of THIS config.
ExecStartPost=/usr/local/libexec/dotmac/job-verify /run/dotmac/@SECRETS_NAMESPACE@/@ROLE@/secrets @DECLARED_FILES@
