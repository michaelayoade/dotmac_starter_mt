# ONE template for serving and job roles alike. Instance = <secrets_namespace>-<role>.
# Static (never enabled), started by the deploy agent through the polkit rule after a
# job, at agent start and before every mint. It runs as the OWNING uid (F26: a
# non-root agent cannot delete inside a 0700 directory it does not own); for the
# import role that is `dotmac-erp-import` (C-29). Without the per-instance drop-in
# (secrets-purge.conf.template) the base ExecStart fails: an unenrolled role purges
# nothing. User=, the directory and the command come ONLY from the per-instance
# root-owned drop-in, never from parsing the instance name (a namespace may contain
# '-'). The base refuses to run without that drop-in and refuses uid 0.
[Unit]
Description=Purge rendered secrets for %i
AssertPathExists=/etc/systemd/system/dotmac-secrets-purge@%i.service.d/secrets-purge.conf

[Service]
Type=oneshot
User=dotmac-secrets-unenrolled
# Runs as the configured User=: it fails if that is root (or unset, so root).
ExecStartPre=/bin/sh -c 'test "$(id -u)" -ne 0'
ExecStart=/usr/bin/false
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
