# /etc/tmpfiles.d/dotmac-@PRODUCT@-@ROLE@.conf. Directories are made here, never
# by the deploy agent. The deploy agent owns the role directory and writes
# `secret_id` (0400) into it as itself; `secrets/` belongs to the container uid
# and is mounted into the container read-only as a DIRECTORY, never per file.
d /run/dotmac 0711 root root -
d /run/dotmac/@PRODUCT@ 0711 dotmac-deploy dotmac-deploy -
d /run/dotmac/@PRODUCT@/@ROLE@ 0711 dotmac-deploy dotmac-deploy -
d /run/dotmac/@PRODUCT@/@ROLE@/secrets 0700 @CONTAINER_USER@ @CONTAINER_USER@ -
