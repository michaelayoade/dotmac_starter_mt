  "deployment_artefact_surfaces": [
    {
      "surface_id": "starter-product-deployment",
      "subject": "The Starter's single deployment declaration and the assets dotmac-deployment-foundation renders from it.",
      "declaration_paths": ["deploy/product.toml"],
      "rendered_paths": [
        "deploy/rendered/docker-compose.yml",
        "deploy/rendered/otel-collector/config.yaml",
